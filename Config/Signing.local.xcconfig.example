// Copy to Config/Signing.local.xcconfig (git-ignored), then run `xcodegen generate`.
// Team ID: Xcode → Settings → Accounts → your team (a free "Personal Team" works; apps then expire after 7 days).
DEVELOPMENT_TEAM = ABCDE12345
// Any reverse-DNS prefix you own or make up; it must be unique to your Apple account.
ZCODE_BUNDLE_ID_PREFIX = com.yourname
